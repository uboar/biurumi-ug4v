---
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';

const { frontmatter = {} } = Astro.props;
const siteName = 'PROJECT BIURUMI';
const title = frontmatter.title ?? siteName;
const description =
  frontmatter.description ??
  'PROJECT BIURUMI character landing page.';
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const normalizePath = (path: string) =>
  path.endsWith('/') ? path : `${path}/`;
const isHome = normalizePath(Astro.url.pathname) === '/';
const ogSlug = isHome
  ? 'index'
  : normalizePath(Astro.url.pathname).replace(/^\/|\/$/g, '').replaceAll('/', '-');
const ogImage = new URL(`/assets/og/${ogSlug}.png`, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/assets/brand/logo.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=LINE+Seed+JP:wght@400;700;800&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class:list={[isHome && "is-home"]}>
    <div class="site-shell">
      {!isHome && <Navigation currentPath={Astro.url.pathname} />}
      <main id="content" transition:animate="fade">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-brand">
          <img src="/assets/brand/typo.svg" alt="PROJECT BIURUMI" loading="lazy" />
          <p>Character landing page shell.</p>
        </div>
        <nav class="footer-meta" aria-label="ページリンク">
          <a href="/about/">びうるみについて</a>
          <a href="/terms/">利用規約</a>
          <a href="/download/">ダウンロード</a>
          <a href="/links/">リンク</a>
        </nav>
      </footer>
    </div>
    <dialog class="artwork-modal" aria-labelledby="artwork-modal-title">
      <div class="artwork-modal-panel">
        <div class="artwork-modal-header">
          <h2 id="artwork-modal-title">Artwork</h2>
          <button class="artwork-modal-close" type="button" aria-label="閉じる">×</button>
        </div>
        <img class="artwork-modal-image" alt="" />
      </div>
    </dialog>
    <script is:inline>
      let currentSampleVoice;
      const artworkModal = document.querySelector('.artwork-modal');
      const artworkModalImage = document.querySelector('.artwork-modal-image');
      const artworkModalTitle = document.querySelector('#artwork-modal-title');
      const artworkModalClose = document.querySelector('.artwork-modal-close');
      let artworkModalCloseTimer;

      const closeArtworkModal = () => {
        if (!artworkModal?.open) {
          return;
        }

        window.clearTimeout(artworkModalCloseTimer);
        artworkModal.classList.add('is-closing');
        artworkModalCloseTimer = window.setTimeout(() => {
          artworkModal.close();
          artworkModal.classList.remove('is-closing');
          if (artworkModalImage) {
            artworkModalImage.removeAttribute('src');
          }
        }, 180);
      };

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) {
          return;
        }

        const artworkButton = event.target.closest('.artwork-zoom-button');

        if (artworkButton && artworkModal && artworkModalImage && artworkModalTitle) {
          const image = artworkButton.querySelector('img');

          if (image) {
            artworkModalImage.src = image.currentSrc || image.src;
            artworkModalImage.alt = image.alt;
            artworkModalTitle.textContent = image.alt || 'Artwork';
            artworkModal.classList.remove('is-closing');
            artworkModal.showModal();
          }

          return;
        }

        const button = event.target.closest('[data-audio-src]');

        if (!button) {
          return;
        }

        const src = button.getAttribute('data-audio-src');

        if (!src) {
          return;
        }

        if (currentSampleVoice) {
          currentSampleVoice.pause();
        }

        currentSampleVoice = new Audio(src);
        currentSampleVoice.play().catch(() => {
          currentSampleVoice = undefined;
        });
      });

      artworkModalClose?.addEventListener('click', () => {
        closeArtworkModal();
      });

      artworkModal?.addEventListener('click', (event) => {
        if (event.target === artworkModal) {
          closeArtworkModal();
        }
      });

      artworkModal?.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeArtworkModal();
      });
    </script>
  </body>
</html>
