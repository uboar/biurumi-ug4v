---
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';

const { frontmatter = {} } = Astro.props;
const siteName = 'PROJECT BIURUMI';
const title = frontmatter.title ?? siteName;
const description =
  frontmatter.description ??
  'PROJECT BIURUMI character landing page.';
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const normalizePath = (path: string) =>
  path.endsWith('/') ? path : `${path}/`;
const isHome = normalizePath(Astro.url.pathname) === '/';
const ogImage = new URL('/assets/og.webp', Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/assets/brand/logo.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=LINE+Seed+JP:wght@400;700;800&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class:list={[isHome && "is-home"]}>
    <div class="site-shell">
      {!isHome && <Navigation currentPath={Astro.url.pathname} />}
      <main id="content" transition:animate="fade">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-brand">
          <img src="/assets/brand/typo.svg" alt="PROJECT BIURUMI" loading="lazy" />
          <p>© 2026 ug4v.com All rights reserved.</p>
        </div>
        <nav class="footer-meta" aria-label="ページリンク">
          <a href="/about/">びうるみについて</a>
          <a href="/terms/">利用規約</a>
          <a href="https://addler.jp/c/biurumi">ダウンロード</a>
          <a href="/links/">リンク</a>
        </nav>
      </footer>
    </div>
    <dialog class="artwork-modal" aria-labelledby="artwork-modal-title">
      <div class="artwork-modal-panel">
        <div class="artwork-modal-header">
          <h2 id="artwork-modal-title">Artwork</h2>
          <div class="artwork-modal-actions">
            <a class="artwork-modal-download" href="#" download target="_blank" rel="noopener">
              元画質DL
            </a>
            <button class="artwork-modal-close" type="button" aria-label="閉じる">×</button>
          </div>
        </div>
        <div class="artwork-modal-viewport" aria-label="アートワーク拡大表示エリア">
          <img class="artwork-modal-image" alt="" draggable="false" />
        </div>
      </div>
    </dialog>
    <script is:inline>
      (() => {
        window.biurumiRuntime?.abortController?.abort();

        const abortController = new AbortController();
        const runtime = {
          abortController,
          currentSampleVoice: window.biurumiRuntime?.currentSampleVoice,
        };

        window.biurumiRuntime = runtime;

        let artworkModalCloseTimer;
        let artworkScale = 1;
        let artworkOffsetX = 0;
        let artworkOffsetY = 0;
        let artworkLastPinchDistance = 0;
        const artworkPointers = new Map();
        const initializedArtworkModals = new WeakSet();
        const initializedArtworkViewports = new WeakSet();
        const artworkMinScale = 1;
        const artworkMaxScale = 5;

        const getArtworkElements = () => ({
          modal: document.querySelector('.artwork-modal'),
          viewport: document.querySelector('.artwork-modal-viewport'),
          image: document.querySelector('.artwork-modal-image'),
          title: document.querySelector('#artwork-modal-title'),
          downloadLink: document.querySelector('.artwork-modal-download'),
        });

        window.biurumiInitKvStages = () => {
          const kvStages = document.querySelectorAll('[data-kv-stage]');
          const waitForImage = (image) => {
            if (image.complete && image.naturalWidth > 0) {
              return Promise.resolve();
            }

            return new Promise((resolve) => {
              image.addEventListener('load', () => resolve(), { once: true });
              image.addEventListener('error', () => resolve(), { once: true });
            });
          };

          kvStages.forEach((stage) => {
            const images = Array.from(stage.querySelectorAll('img'));

            if (images.length === 0) {
              stage.classList.remove('is-kv-pending');
              stage.classList.add('is-kv-ready');
              return;
            }

            Promise.all(images.map(waitForImage)).then(() => {
              requestAnimationFrame(() => {
                if (!stage.isConnected) {
                  return;
                }

                stage.classList.remove('is-kv-pending');
                stage.classList.add('is-kv-ready');
              });
            });
          });
        };

        const clampArtworkOffset = () => {
          const { viewport, image } = getArtworkElements();

          if (!viewport || !image) {
            return;
          }

          const viewportRect = viewport.getBoundingClientRect();
          const maxX = Math.max(0, (image.offsetWidth * artworkScale - viewportRect.width) / 2);
          const maxY = Math.max(0, (image.offsetHeight * artworkScale - viewportRect.height) / 2);

          artworkOffsetX = Math.min(maxX, Math.max(-maxX, artworkOffsetX));
          artworkOffsetY = Math.min(maxY, Math.max(-maxY, artworkOffsetY));
        };

        const applyArtworkZoom = () => {
          const { image } = getArtworkElements();

          if (!image) {
            return;
          }

          clampArtworkOffset();
          image.style.setProperty('--artwork-scale', String(artworkScale));
          image.style.setProperty('--artwork-x', `${artworkOffsetX}px`);
          image.style.setProperty('--artwork-y', `${artworkOffsetY}px`);
          image.classList.toggle('is-zoomed', artworkScale > artworkMinScale);
        };

        const resetArtworkZoom = () => {
          artworkScale = artworkMinScale;
          artworkOffsetX = 0;
          artworkOffsetY = 0;
          artworkLastPinchDistance = 0;
          artworkPointers.clear();
          applyArtworkZoom();
        };

        const closeArtworkModal = () => {
          const { modal, image, downloadLink } = getArtworkElements();

          if (!modal?.open) {
            return;
          }

          window.clearTimeout(artworkModalCloseTimer);
          modal.classList.add('is-closing');
          artworkModalCloseTimer = window.setTimeout(() => {
            modal.close();
            modal.classList.remove('is-closing');
            image?.removeAttribute('src');
            downloadLink?.removeAttribute('href');
            downloadLink?.removeAttribute('download');
            resetArtworkZoom();
          }, 180);
        };

        const zoomArtworkAt = (nextScale, clientX, clientY) => {
          const { viewport } = getArtworkElements();

          if (!viewport) {
            return;
          }

          const clampedScale = Math.min(artworkMaxScale, Math.max(artworkMinScale, nextScale));
          const ratio = clampedScale / artworkScale;
          const viewportRect = viewport.getBoundingClientRect();
          const localX = clientX - viewportRect.left - viewportRect.width / 2;
          const localY = clientY - viewportRect.top - viewportRect.height / 2;

          artworkOffsetX = localX - (localX - artworkOffsetX) * ratio;
          artworkOffsetY = localY - (localY - artworkOffsetY) * ratio;
          artworkScale = clampedScale;
          applyArtworkZoom();
        };

        const getArtworkPointerDistance = () => {
          const pointers = Array.from(artworkPointers.values());

          if (pointers.length < 2) {
            return 0;
          }

          return Math.hypot(pointers[0].clientX - pointers[1].clientX, pointers[0].clientY - pointers[1].clientY);
        };

        const getArtworkPointerCenter = () => {
          const pointers = Array.from(artworkPointers.values());

          return {
            clientX: (pointers[0].clientX + pointers[1].clientX) / 2,
            clientY: (pointers[0].clientY + pointers[1].clientY) / 2,
          };
        };

        const bindArtworkModalControls = () => {
          const { modal, viewport } = getArtworkElements();

          if (modal && !initializedArtworkModals.has(modal)) {
            initializedArtworkModals.add(modal);
            modal.addEventListener(
              'cancel',
              (event) => {
                event.preventDefault();
                closeArtworkModal();
              },
              { signal: abortController.signal },
            );
          }

          if (!viewport || initializedArtworkViewports.has(viewport)) {
            return;
          }

          initializedArtworkViewports.add(viewport);
          viewport.addEventListener(
            'wheel',
            (event) => {
              const { modal: currentModal } = getArtworkElements();

              if (!currentModal?.open) {
                return;
              }

              event.preventDefault();
              const zoomFactor = Math.exp(-event.deltaY * 0.002);
              zoomArtworkAt(artworkScale * zoomFactor, event.clientX, event.clientY);
            },
            { passive: false, signal: abortController.signal },
          );

          viewport.addEventListener(
            'pointerdown',
            (event) => {
              viewport.setPointerCapture(event.pointerId);
              artworkPointers.set(event.pointerId, {
                clientX: event.clientX,
                clientY: event.clientY,
              });

              if (artworkPointers.size === 2) {
                artworkLastPinchDistance = getArtworkPointerDistance();
              }
            },
            { signal: abortController.signal },
          );

          viewport.addEventListener(
            'pointermove',
            (event) => {
              if (!artworkPointers.has(event.pointerId)) {
                return;
              }

              const previousPointer = artworkPointers.get(event.pointerId);

              artworkPointers.set(event.pointerId, {
                clientX: event.clientX,
                clientY: event.clientY,
              });

              if (artworkPointers.size === 1 && artworkScale > artworkMinScale && previousPointer) {
                artworkOffsetX += event.clientX - previousPointer.clientX;
                artworkOffsetY += event.clientY - previousPointer.clientY;
                applyArtworkZoom();
                return;
              }

              if (artworkPointers.size !== 2) {
                return;
              }

              const nextDistance = getArtworkPointerDistance();

              if (artworkLastPinchDistance > 0 && nextDistance > 0) {
                const center = getArtworkPointerCenter();
                zoomArtworkAt(artworkScale * (nextDistance / artworkLastPinchDistance), center.clientX, center.clientY);
              }

              artworkLastPinchDistance = nextDistance;
            },
            { signal: abortController.signal },
          );

          const endArtworkPointer = (event) => {
            artworkPointers.delete(event.pointerId);

            if (artworkPointers.size < 2) {
              artworkLastPinchDistance = 0;
            }
          };

          viewport.addEventListener('pointerup', endArtworkPointer, { signal: abortController.signal });
          viewport.addEventListener('pointercancel', endArtworkPointer, { signal: abortController.signal });
          viewport.addEventListener('lostpointercapture', endArtworkPointer, { signal: abortController.signal });
        };

        document.addEventListener(
          'click',
          (event) => {
            if (!(event.target instanceof Element)) {
              return;
            }

            if (event.target.closest('.artwork-modal-close') || event.target.matches('.artwork-modal')) {
              closeArtworkModal();
              return;
            }

            const artworkButton = event.target.closest('.artwork-zoom-button');

            if (artworkButton) {
              const { modal, image: modalImage, title, downloadLink } = getArtworkElements();
              const image = artworkButton.querySelector('img');

              if (modal && modalImage && title && image) {
                const downloadSrc = image.getAttribute('data-download-src') || image.src;
                const downloadFilename = decodeURIComponent(downloadSrc.split('/').pop() || 'artwork.webp');

                window.clearTimeout(artworkModalCloseTimer);
                resetArtworkZoom();
                modalImage.src = image.currentSrc || image.src;
                modalImage.alt = image.alt;
                title.textContent = image.alt || 'Artwork';
                downloadLink?.setAttribute('href', downloadSrc);
                downloadLink?.setAttribute('download', downloadFilename);
                modal.classList.remove('is-closing');

                if (!modal.open) {
                  modal.showModal();
                }
              }

              return;
            }

            const termsAgreeButton = event.target.closest('[data-terms-agree-button]');

            if (termsAgreeButton) {
              const termsDownloadGate = termsAgreeButton.closest('[data-terms-download-gate]');
              const termsDownloadCode = termsDownloadGate?.querySelector('[data-terms-download-code]');

              termsDownloadCode?.removeAttribute('hidden');
              termsDownloadGate?.classList.add('is-agreed');
              termsAgreeButton.setAttribute('disabled', '');
              termsAgreeButton.textContent = '利用規約に同意済み';

              return;
            }

            const button = event.target.closest('[data-audio-src]');

            if (!button) {
              return;
            }

            const src = button.getAttribute('data-audio-src');

            if (!src) {
              return;
            }

            if (runtime.currentSampleVoice) {
              runtime.currentSampleVoice.pause();
            }

            runtime.currentSampleVoice = new Audio(src);
            runtime.currentSampleVoice.volume = 0.5;
            runtime.currentSampleVoice.play().catch(() => {
              runtime.currentSampleVoice = undefined;
            });
          },
          { signal: abortController.signal },
        );

        const initPage = () => {
          window.biurumiInitKvStages();
          bindArtworkModalControls();
        };

        initPage();
        document.addEventListener('astro:page-load', initPage, { signal: abortController.signal });
      })();
    </script>
  </body>
</html>
