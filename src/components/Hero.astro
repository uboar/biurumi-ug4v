    <img src="/assets/brand/ug4v-logo-white.svg" width="1080" height="1080" alt="" loading="eager" decoding="async" />
  </div>
  <div class="home-wordmark" aria-hidden="true">
    <span>CHARACTER PROJECT びうるみ</span>
    <strong>BIURUMI</strong>
  </div>

  <div class="kv-stage" role="img" aria-label="PROJECT BIURUMI character key visual">
    <img class={kvLayers[0].className} src={kvLayers[0].src} width="1958" height="2160" alt="" aria-hidden="true" loading="eager" decoding="async" fetchpriority="high" />
    <img class={kvLayers[1].className} src={kvLayers[1].src} width="1958" height="2160" alt="" aria-hidden="true" loading="eager" decoding="async" fetchpriority="high" />
    <div class="kv-lower-pattern" aria-hidden="true"></div>
    <img class={kvLayers[2].className} src={kvLayers[2].src} width="1958" height="2160" alt="" aria-hidden="true" loading="eager" decoding="async" fetchpriority="high" />
    <img class={kvLayers[3].className} src={kvLayers[3].src} width="1958" height="2160" alt="" aria-hidden="true" loading="eager" decoding="async" fetchpriority="high" />
    <img class={kvLayers[4].className} src={kvLayers[4].src} width="1958" height="2160" alt="" aria-hidden="true" loading="eager" decoding="async" fetchpriority="high" />
    <img class={kvLayers[5].className} src={kvLayers[5].src} width="1958" height="2160" alt="" aria-hidden="true" loading="eager" decoding="async" fetchpriority="high" />
  </div>

  <div class="home-topics" aria-labelledby="home-topics-title">
    <h2 id="home-topics-title">TOPICS</h2>
    <div class="topic-list">
